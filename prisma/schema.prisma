generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String
  name               String
  photoUrl           String?
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("admins")
}

model Doctor {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  passwordHash         String
  phone                String
  specialization       String    @default("Pediatrician")
  qualification        String?
  experience           Int       @default(0)
  bio                  String?   @db.Text
  // Bug 6 — clinic location (per-doctor)
  clinicName           String?
  clinicAddress        String?   @db.Text
  clinicMapUrl         String?   @db.Text
  clinicLat            Decimal?  @db.Decimal(10, 7)
  clinicLng            Decimal?  @db.Decimal(10, 7)
  photoUrl             String?
  // Feature 3 — Doctor Digital Signature (relative URL path to PNG in storage/signatures)
  signatureUrl         String?
  // Registration / medical council info shown on medical certificates
  registrationNumber   String?
  consultationModes    String    @default("BOTH")
  onlineConsultFee     Decimal   @default(0) @db.Decimal(10, 2)
  physicalConsultFee   Decimal   @default(0) @db.Decimal(10, 2)
  availableFromOnline  String?
  availableToOnline    String?
  availableFromOffline String?
  availableToOffline   String?
  workingDays          String    @default("MON,TUE,WED,THU,FRI,SAT")
  slotDuration         Int       @default(15)
  isAvailable          Boolean   @default(true)
  mustChangePassword   Boolean   @default(false)
  deletedAt            DateTime?
  consults             Int       @default(0)
  revenue              Decimal   @default(0) @db.Decimal(12, 2)

  clinicSharePercent Decimal @default(25.00) @db.Decimal(5, 2)
  doctorSharePercent Decimal @default(75.00) @db.Decimal(5, 2)
  tdsPercent         Decimal @default(10.00) @db.Decimal(5, 2)
  canAddPreviousRecords Boolean @default(false)
  appointments Appointment[]
  previousRecords PreviousRecord[]
  settlements  DoctorSettlement[]
  kyc          DoctorKyc?
  certificates MedicalCertificate[]
  receptionistAssignments ReceptionistAssignment[]
  pharmacyUserDoctors PharmacyUserDoctor[]
  pharmacyBills PharmacyBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("doctors")
}

model Patient {
  id           String        @id @default(uuid())
  name         String
  phone        String
  email        String?
  dateOfBirth  DateTime?
  gender       String?
  parentName   String?
  address      String?       @db.Text
  appointments Appointment[]
  previousRecords PreviousRecord[]
  certificates MedicalCertificate[]
  pharmacyBills PharmacyBill[]
  registrations PatientRegistration[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([phone])
  @@index([phone, name])
  @@map("patients")
}

model Appointment {
  id                String        @id @default(uuid())
  doctorId          String
  patientId         String
  primaryProblem    String        @db.Text
  date              DateTime      @db.Date
  startTime         String
  endTime           String
  consultationType  String
  feeAtBooking      Decimal       @db.Decimal(10, 2)
  status            String        @default("PENDING")
  paymentStatus     String        @default("UNPAID")
  cashfreeOrderId   String?
  cashfreePaymentId String?
  refundId          String?
  refundedAt        DateTime?
  meetLink          String?       @db.Text
  meetEventId       String?
  invoiceUrl        String?
  prescriptionUrl   String?
  rescheduleReason  String?       @db.Text
  rescheduledAt     DateTime?
  rescheduledFromId String?
  expiresAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  notes             String?       @db.Text

  // ─────────────────────────────────────────────────────────────────
  // Feature 1 — Historical / Manual Appointment Records
  //
  // `source`  : "NEOKIDSPRO" (default, unchanged for existing rows)
  //             OR "MANUAL" for records added manually by staff.
  //             Kept as a string so we don't require a schema migration
  //             for a future new source (e.g. "CSV_IMPORT").
  //
  // `diagnosis`, `reasonForVisit`, `followUpDate`  — historical rows
  // typically don't have a full Prescription row attached, so we mirror
  // a minimal clinical snapshot on the appointment itself. These fields
  // are ALWAYS optional and are IGNORED for normal (source=NEOKIDSPRO)
  // appointments — the existing Prescription flow still owns the
  // primary clinical record.
  //
  // `manualPrescriptionUrl` — signed URL to an uploaded (scanned)
  // prescription PDF/JPG/PNG. Distinct from `prescriptionUrl` which is
  // the system-generated PDF path.
  //
  // `addedById`, `addedByRole` — audit trail: who added the record.
  // ─────────────────────────────────────────────────────────────────
  source                 String    @default("NEOKIDSPRO")
  reasonForVisit         String?   @db.Text
  diagnosis              String?   @db.Text
  followUpDate           DateTime?
  manualPrescriptionUrl  String?
  addedById              String?
  addedByRole            String?

  arrivedAt              DateTime?
  medicalCentreId        String?
  createdByReceptionistId String?
  createdByReceptionist  Receptionist? @relation(fields: [createdByReceptionistId], references: [id], onDelete: SetNull)
  medicalCentre          MedicalCentre? @relation("CentreAppointments", fields: [medicalCentreId], references: [id], onDelete: SetNull)
  consultationInvoice    ConsultationInvoice?

  doctor            Doctor        @relation(fields: [doctorId], references: [id])
  patient           Patient       @relation(fields: [patientId], references: [id])
  prescription      Prescription?
  certificates      MedicalCertificate[]

  settlementId String?
  settlement   DoctorSettlement? @relation(fields: [settlementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, date, startTime], name: "unique_doctor_slot")
  @@index([date, doctorId])
  @@index([patientId])
  @@index([status])
  @@index([expiresAt])
  @@index([doctorId, paymentStatus, date])
  @@index([settlementId])
  @@index([source])
  @@index([medicalCentreId])
  @@index([createdByReceptionistId])
  @@index([arrivedAt])
  @@map("appointments")
}

model Prescription {
  id             String      @id @default(uuid())
  appointmentId  String      @unique
  chiefComplaint String      @db.Text
  weight         String?
  height         String?
  pastHistory    String?     @db.Text
  diagnosis      String      @db.Text
  allergies      String?     @db.Text
  investigations String?     @db.Text
  medications    Json
  advice         String?     @db.Text
  followUpDate   DateTime?
  // Feature 1A — flag if this prescription record represents a manually
  // uploaded historical prescription (as opposed to a system-generated one).
  source         String      @default("NEOKIDSPRO")
  createdById    String?
  createdByRole  String?
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("prescriptions")
}

model PreviousRecord {
  id            String   @id @default(uuid())
  doctorId      String
  // v3.4.8 — patientId is now OPTIONAL. A record either links to a real
  // NeoKidsPro patient (patientId set, patientSource = "EXISTING") or
  // belongs to a manually-entered pre-EMR patient that was never
  // registered in the directory (patientId null, patientSource =
  // "LEGACY", legacyPatient* fields populated instead). See the
  // "Patient Linkage" fix notes in previous.controller.js.
  patientId     String?
  recordDate    DateTime @db.Date
  diagnosis     String?  @db.Text
  notes         String?  @db.Text
  treatment     String?  @db.Text
  medications   String?  @db.Text
  attachmentUrl String?

  // ───────────────────────────────────────────────
  // v3.4.8 — Patient linkage rework columns.
  // patientSource tells the UI/API which "ownership" branch a record is
  // in: 'EXISTING' (linked to a real Patient row) or 'LEGACY' (manually
  // entered, pre-EMR patient with no directory record). The legacy*
  // fields are only populated when patientSource = 'LEGACY'.
  patientSource      String   @default("EXISTING") // 'EXISTING' | 'LEGACY'
  legacyPatientName  String?
  legacyPatientPhone String?
  legacyPatientDob   DateTime? @db.Date
  legacyPatientGender String?
  legacyPatientGuardian String?
  legacyPatientNotes String?  @db.Text

  // ───────────────────────────────────────────────
  // v3.4.3+ professional-EMR rework columns.
  // The migration 20260817120000_historical_records_pro
  // already applies them to MySQL. The Prisma model MUST
  // declare them so the generated client recognises the
  // field names — otherwise `prisma.previousRecord.create({
  // data: { title, recordType, ... } })` throws
  // PrismaClientValidationError ("Invalid input for database
  // operation").
  title               String?
  recordType          String?  // LAB_REPORT | RADIOLOGY | CONSULTATION | PRESCRIPTION | VACCINATION | DISCHARGE | OTHER
  pdfUrl              String?
  pdfGeneratedAt      DateTime?
  shareToken          String?  @unique
  shareTokenExpiresAt DateTime?
  lastSharedAt        DateTime?
  lastSharedVia       String?  // 'WHATSAPP' | 'EMAIL'
  deletedAt           DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  doctor      Doctor                 @relation(fields: [doctorId], references: [id])
  // Optional now — see patientId comment above. onDelete: SetNull so
  // deleting a patient record never cascades into wiping a doctor's
  // previous-record history; it just detaches (record still has the
  // patient's name/phone frozen in place via patientSource fallback
  // display on the frontend, if ever needed).
  patient     Patient?               @relation(fields: [patientId], references: [id], onDelete: SetNull)
  attachments PreviousRecordAttachment[]

  @@index([doctorId, patientId, recordDate])
  @@index([patientId, recordDate])
  @@index([deletedAt])
  @@index([patientSource])
  @@map("previous_records")
}

// One row per attachment (PDFs, JPGs, scans, prescriptions).
// The table itself is created by migration
// 20260817120000_historical_records_pro; the model declaration
// must stay in lock-step with that migration or the v3.4.4
// upload/replace/delete/share endpoints all throw
// PrismaClientValidationError at runtime.
model PreviousRecordAttachment {
  id              String   @id @default(uuid())
  recordId        String
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       Int      @default(0)
  label           String?
  kind            String?  // 'PDF' | 'IMAGE' | 'PRESCRIPTION' | 'LEGACY' | 'OTHER'
  attachmentType  String?  // doctor-chosen category, independent of `kind`
  notes           String?  @db.VarChar(2000)
  sortOrder       Int      @default(0)
  storagePath     String
  uploadedById    String?
  uploadedByRole  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  record PreviousRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@index([recordId, sortOrder])
  @@map("previous_record_attachments")
}

// ─────────────────────────────────────────────────────────────────────
// Feature 2 — Medical Certificate Generator
// ─────────────────────────────────────────────────────────────────────
model MedicalCertificate {
  id                String    @id @default(uuid())
  certificateNumber String    @unique
  appointmentId     String?
  patientId         String
  doctorId          String

  // Template drives copy/wording. Free string so admins can register new
  // templates later without a migration.
  templateKey       String    @default("GENERAL")

  diagnosis         String?   @db.Text
  reason            String    @db.Text
  restDays          Int?
  fromDate          DateTime?
  toDate            DateTime?
  additionalNotes   String?   @db.Text

  // v3.4.0 — duration semantics: "SINGLE_DAY" uses certificateDate only;
  // "DATE_RANGE" uses fromDate/toDate. Stored as a plain string so legacy
  // rows (NULL) keep rendering exactly as before via the DATE_RANGE fallback.
  durationType      String?
  certificateDate   DateTime?

  // v3.4.0 — consultation-mode snapshot at issue time ("ONLINE" / "OFFLINE").
  // The PDF layout adapts from this so a later switch of the appointment's
  // mode never retroactively rewrites an already-issued certificate.
  consultationType  String?

  // Snapshotted patient info at time of issue (defends against later edits).
  patientNameSnapshot String
  patientAgeSnapshot  String?
  patientGenderSnapshot String?

  pdfUrl            String?

  issuedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  issuedById        String?
  issuedByRole      String?

  appointment       Appointment? @relation(fields: [appointmentId], references: [id])
  patient           Patient      @relation(fields: [patientId], references: [id])
  doctor            Doctor       @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([issuedAt])
  @@map("medical_certificates")
}

model NotificationLog {
  id            String   @id @default(uuid())
  appointmentId String?
  channel       String
  recipient     String
  template      String
  direction     String?
  status        String
  payload       Json?
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())

  claimKey String?

  @@index([appointmentId])
  @@index([status])
  @@unique([claimKey], name: "unique_reminder_claim")
  @@map("notification_logs")
}

model PasswordToken {
  id        String    @id @default(uuid())
  userType  String
  userId    String
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userType, userId, purpose])
  @@index([expiresAt])
  @@map("password_tokens")
}

model DoctorSettlement {
  id String @id @default(uuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  periodMonth Int
  periodYear  Int

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  clinicSharePercent Decimal @db.Decimal(5, 2)
  doctorSharePercent Decimal @db.Decimal(5, 2)
  tdsPercent         Decimal @db.Decimal(5, 2)

  totalConsultations Int     @default(0)
  totalRevenue       Decimal @default(0) @db.Decimal(14, 2)

  clinicShareAmount Decimal @default(0) @db.Decimal(14, 2)
  doctorGrossAmount Decimal @default(0) @db.Decimal(14, 2)

  tdsAmount       Decimal @default(0) @db.Decimal(14, 2)
  doctorNetAmount Decimal @default(0) @db.Decimal(14, 2)

  status String @default("GENERATED")

  paidAt           DateTime?
  paymentReference String?
  paymentMode      String?
  paymentNotes     String?   @db.Text

  processedById String?

  invoiceNumber      String?   @unique
  invoiceUrl         String?
  invoiceGeneratedAt DateTime?

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, periodYear, periodMonth], name: "unique_doctor_period")
  @@index([periodYear, periodMonth])
  @@index([status])
  @@index([doctorId, status])
  @@map("doctor_settlements")
}

// ═════════════════════════════════════════════════════════════════════
// v4.0.0 — Receptionist, Medical Centre & Pharmacy module
// ═════════════════════════════════════════════════════════════════════

model MedicalCentre {
  id        String   @id @default(uuid())
  name      String
  address   String?  @db.Text
  phone     String?
  email     String?
  city      String?
  state     String?
  pincode   String?
  mapUrl    String?  @db.Text
  isActive  Boolean  @default(true)

  receptionistAssignments ReceptionistAssignment[]
  appointments            Appointment[]        @relation("CentreAppointments")
  pharmacyUsers           PharmacyUser[]
  pharmacyItems           PharmacyItem[]
  pharmacyBills           PharmacyBill[]
  consultationInvoices    ConsultationInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("medical_centres")
}

model Receptionist {
  id                 String    @id @default(uuid())
  name               String
  phone              String
  email              String    @unique
  passwordHash       String
  photoUrl           String?
  status             String    @default("ACTIVE") // ACTIVE | SUSPENDED
  canManageConsultations Boolean @default(true)
  canManagePharmacy  Boolean   @default(false)
  canIssueCertificates Boolean @default(false)
  mustChangePassword Boolean   @default(false)
  deletedAt          DateTime?

  assignments         ReceptionistAssignment[]
  createdAppointments Appointment[]
  consultationInvoices ConsultationInvoice[]
  patientRegistrations PatientRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("receptionists")
}

model ReceptionistAssignment {
  id              String        @id @default(uuid())
  receptionistId  String
  doctorId        String
  medicalCentreId String
  createdAt       DateTime      @default(now())

  receptionist  Receptionist  @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicalCentre MedicalCentre @relation(fields: [medicalCentreId], references: [id], onDelete: Cascade)

  @@unique([receptionistId, doctorId, medicalCentreId])
  @@index([doctorId])
  @@index([medicalCentreId])
  @@map("receptionist_assignments")
}

model PharmacyUser {
  id               String    @id @default(uuid())
  name             String
  phone            String
  email            String    @unique
  passwordHash     String
  photoUrl         String?
  status           String    @default("ACTIVE")
  medicalCentreId  String?
  mustChangePassword Boolean @default(false)
  deletedAt        DateTime?

  medicalCentre MedicalCentre?      @relation(fields: [medicalCentreId], references: [id], onDelete: SetNull)
  doctors       PharmacyUserDoctor[]
  patientRegistrations PatientRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([medicalCentreId])
  @@map("pharmacy_users")
}

model PharmacyUserDoctor {
  id             String   @id @default(uuid())
  pharmacyUserId String
  doctorId       String
  createdAt      DateTime @default(now())

  pharmacyUser PharmacyUser @relation(fields: [pharmacyUserId], references: [id], onDelete: Cascade)
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([pharmacyUserId, doctorId])
  @@index([doctorId])
  @@map("pharmacy_user_doctors")
}

// Explicit registration linkage so a patient created at the front desk is
// immediately visible to the staff member who registered them, without
// waiting for a first appointment or certificate to bring them into scope.
model PatientRegistration {
  id              String   @id @default(uuid())
  patientId       String
  receptionistId  String?
  pharmacyUserId  String?
  medicalCentreId String?
  createdAt       DateTime @default(now())

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  receptionist Receptionist? @relation(fields: [receptionistId], references: [id], onDelete: Cascade)
  pharmacyUser PharmacyUser? @relation(fields: [pharmacyUserId], references: [id], onDelete: Cascade)

  @@unique([patientId, receptionistId])
  @@unique([patientId, pharmacyUserId])
  @@index([receptionistId])
  @@index([pharmacyUserId])
  @@index([patientId])
  @@map("patient_registrations")
}

model ConsultationInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  appointmentId   String   @unique
  doctorId        String
  patientId       String
  receptionistId  String?
  medicalCentreId String?
  amount          Decimal  @db.Decimal(10, 2)
  status          String   @default("PAID") // PAID | PENDING
  paymentMethod   String   @default("CASH")
  notes           String?  @db.Text
  pdfUrl          String?

  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  receptionist  Receptionist?  @relation(fields: [receptionistId], references: [id], onDelete: SetNull)
  medicalCentre MedicalCentre? @relation(fields: [medicalCentreId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([medicalCentreId])
  @@index([patientId])
  @@index([createdAt])
  @@map("consultation_invoices")
}

model PharmacyItem {
  id              String    @id @default(uuid())
  medicalCentreId String?
  name            String
  batchNumber     String?
  unit            String    @default("strip")
  mrp             Decimal   @default(0) @db.Decimal(10, 2)
  purchasePrice   Decimal   @default(0) @db.Decimal(10, 2)
  sellingPrice    Decimal   @default(0) @db.Decimal(10, 2)
  stock           Int       @default(0)
  expiryDate      DateTime?
  manufacturer    String?
  isActive        Boolean   @default(true)

  medicalCentre MedicalCentre?     @relation(fields: [medicalCentreId], references: [id], onDelete: SetNull)
  billItems     PharmacyBillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicalCentreId])
  @@index([name])
  @@index([expiryDate])
  @@map("pharmacy_items")
}

model PharmacyBill {
  id              String   @id @default(uuid())
  billNumber      String   @unique
  medicalCentreId String?
  patientId       String?
  prescriptionId  String?
  doctorId        String?
  createdById     String?
  createdByRole   String?
  customerName    String?
  customerPhone   String?
  subtotal        Decimal  @default(0) @db.Decimal(10, 2)
  discount        Decimal  @default(0) @db.Decimal(10, 2)
  tax             Decimal  @default(0) @db.Decimal(10, 2)
  total           Decimal  @default(0) @db.Decimal(10, 2)
  paymentMethod   String   @default("CASH")
  // Unified billing engine: PHARMACY | CONSULT | SERVICE. Receptionists use
  // the same engine for consultation / vaccination / procedure / certificate
  // type bills instead of a parallel invoice model.
  billType        String   @default("PHARMACY")
  // Lifecycle: DRAFT (unpaid, editable) -> PAID (locked). Existing rows keep
  // their historical 'PAID' value; new rows default to DRAFT.
  status          String   @default("DRAFT")
  paidAt          DateTime?
  paidById        String?
  paidByRole      String?
  editedAt        DateTime?
  editedById      String?
  editedByRole    String?
  editCount       Int      @default(0)
  edits           Json?
  pdfUrl          String?
  notes           String?  @db.Text

  medicalCentre MedicalCentre?     @relation(fields: [medicalCentreId], references: [id], onDelete: SetNull)
  doctor        Doctor?            @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient       Patient?           @relation(fields: [patientId], references: [id], onDelete: SetNull)
  items         PharmacyBillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicalCentreId])
  @@index([patientId])
  @@index([doctorId])
  @@index([billType])
  @@index([status])
  @@index([createdAt])
  @@map("pharmacy_bills")
}

model PharmacyBillItem {
  id        String   @id @default(uuid())
  billId    String
  itemId    String?
  name      String
  quantity  Int
  unitPrice Decimal  @default(0) @db.Decimal(10, 2)
  total     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill PharmacyBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  item PharmacyItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([itemId])
  @@map("pharmacy_bill_items")
}

model StaffAuditLog {
  id              String   @id @default(uuid())
  actorId         String
  actorRole       String
  actorName       String?
  action          String
  entityType      String?
  entityId        String?
  summary         String?
  meta            Json?
  medicalCentreId String?
  doctorId        String?
  createdAt       DateTime @default(now())

  @@index([actorId])
  @@index([actorRole])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("staff_audit_logs")
}

// In-app notification bell, shared across all 4 portals. userId is null for
// an admin-wide notice (every admin account sees it — there's no concept of
// a single "team" admin, so a per-admin-id notice would silently go unseen
// by other admins). Doctor/Receptionist/Pharmacy notifications always carry
// a userId since those roles are single-account, not shared.
model Notification {
  id         String    @id @default(uuid())
  userType   String
  userId     String?
  type       String
  title      String
  message    String    @db.Text
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userType, userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model DoctorKyc {
  id       String @id @default(uuid())
  doctorId String @unique
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  aadhaarUrl         String?
  panUrl             String?
  cancelledChequeUrl String?
  medicalRegCertUrl  String?

  kycStatus       String    @default("PENDING")
  rejectionReason String?   @db.Text
  verifiedAt      DateTime?
  verifiedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kycStatus])
  @@map("doctor_kyc")
}
